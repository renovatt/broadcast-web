# Copie para .env.local e preencha com a config do app Web
# (Firebase Console → Configurações do projeto → Seus apps → </>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# "true" conecta Auth/Firestore aos emuladores locais (firebase emulators:start)
VITE_USE_EMULATORS=false

# "false" quando as Cloud Functions não estão publicadas (plano Spark): o app avisa que o
# agendamento não é processado e esconde o resumo das conexões. Ausente = habilitadas.
VITE_FUNCTIONS_ENABLED=true
